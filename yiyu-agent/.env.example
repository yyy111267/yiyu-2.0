# ============================================
# 以渔2.0 环境变量配置示例
# 使用方法：
#   cp .env.example .env
#   然后编辑 .env，填入你自己的 API Key
# ============================================

# --- LLM 配置 ---
# OpenAI 兼容 API（支持 DeepSeek、混元3、OpenAI 等）
# 注意：config.py 用 env_prefix="IC_"，变量名必须带 IC_ 前缀才会被读取
#
# 混元3（腾讯 MaaS TokenHub）示例：
#   IC_LLM_API_KEY=sk-xxxx
#   IC_LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1
#   IC_LLM_MODEL=hy3
# DeepSeek 示例：
#   IC_LLM_API_KEY=sk-xxxx
#   IC_LLM_BASE_URL=https://api.deepseek.com/v1
#   IC_LLM_MODEL=deepseek-chat
IC_LLM_API_KEY=sk-your-api-key-here
IC_LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1
IC_LLM_REQUEST_TIMEOUT_SECONDS=60
IC_LLM_THINKING_ENABLED=true
IC_LLM_REASONING_EFFORT=low
IC_LLM_MAX_TOKENS=1024
# 时间预算：preloop 失败只降级；research 是停止探索的 soft limit；hard 才终止请求。
#   research = 正式 loop 的探索预算，达到后禁止继续调工具并进入 synthesis
#   research_hard = 整个 Agent run 的系统级生命线
#   preloop  = 轻量启动器上限（实体解析 + 并行上下文准备 + 计划生成）
#   finalize = 收尾轮 LLM 组织答案的时限（受 research 剩余预算封顶）
IC_PRELOOP_TIMEOUT_SECONDS=30
IC_RESEARCH_TIMEOUT_SECONDS=200
IC_RESEARCH_HARD_TIMEOUT_SECONDS=300
IC_FINALIZE_TIMEOUT_SECONDS=70
IC_AGENT_MAX_STEPS=6
IC_AGENT_MAX_TOKENS=50000
IC_AGENT_MAX_TOOL_CALLS=36
IC_AGENT_MAX_NO_PROGRESS_ROUNDS=2
IC_AGENT_MAX_CONSECUTIVE_LLM_FAILURES=2
IC_AGENT_BREAKER_FAILURE_THRESHOLD=5
IC_AGENT_BREAKER_RECOVERY_SECONDS=30
IC_TRACE_ENABLED=true
IC_TRACE_DIR=./data/traces
IC_LLM_MODEL=hy3
IC_LLM_TEMPERATURE=0.7
IC_LLM_MAX_TOKENS=4096

# --- 联网搜索（博查 Web Search API）---
# web.search 工具的搜索源，白名单过滤用其原生 include 参数（服务端按域名过滤）
# 注册/充值：https://open.bocha.cn ；按次计费（不返回摘要约 0.03 元/次）
IC_BOCHA_API_KEY=

# --- 数据库配置 ---
IC_DATABASE_URL=sqlite+aiosqlite:///./data/invest_coach.db

# --- 服务配置 ---
IC_ENV=dev
IC_HOST=0.0.0.0
IC_PORT=8000
IC_API_PREFIX=/api/v1
IC_DEBUG=true

# --- CORS 配置 ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- 邮箱登录（生产必填）---
IC_SMTP_HOST=smtp.example.com
IC_SMTP_PORT=465
IC_SMTP_USER=
IC_SMTP_PASS=
IC_SMTP_FROM=

# --- 日志配置 ---
IC_LOG_LEVEL=INFO
