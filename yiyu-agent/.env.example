# ============================================
# 以渔2.0 环境变量配置示例
# 使用方法：
#   cp .env.example .env
#   然后编辑 .env，填入你自己的 API Key
# ============================================

# --- LLM 配置 ---
# OpenAI 兼容 API（支持 DeepSeek、OpenAI 等）
# 注意：config.py 用 env_prefix="IC_"，变量名必须带 IC_ 前缀才会被读取
IC_LLM_API_KEY=sk-your-api-key-here
IC_LLM_BASE_URL=https://api.deepseek.com/v1
IC_LLM_MODEL=deepseek-chat
IC_LLM_TEMPERATURE=0.7
IC_LLM_MAX_TOKENS=4096

# --- 数据库配置 ---
DATABASE_URL=sqlite:///./yiyu_agent.db

# --- 服务配置 ---
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
DEBUG=true

# --- CORS 配置 ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Agent 配置 ---
AGENT_MAX_STEPS=20
AGENT_MAX_TOKENS=50000
AGENT_MAX_TOOL_CALLS=30
AGENT_TIMEOUT_SECONDS=300

# --- 熔断器配置 ---
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30

# --- 日志配置 ---
LOG_LEVEL=INFO
LOG_FILE=yiyu_agent.log
