# 以渔2.0 生产环境配置模板
# 复制为 .env.prod 并填入真实值；secrets 不进镜像，通过此文件注入

# ── 环境 ──
IC_ENV=prod
IC_DEBUG=False
IC_LOG_LEVEL=INFO

# ── 存储 ──
IC_DATABASE_URL=sqlite+aiosqlite:///./data/invest_coach.db
IC_MARKET_CACHE_ENABLED=True

# ── LLM（必须填）──
IC_LLM_PROVIDER=hunyuan
IC_LLM_MODEL=hy3
IC_LLM_API_KEY=填入你的 LLM API Key
# IC_LLM_BASE_URL=https://自定义端点/v1
IC_LLM_REQUEST_TIMEOUT_SECONDS=60
IC_LLM_THINKING_ENABLED=true
IC_LLM_REASONING_EFFORT=low
IC_LLM_MAX_TOKENS=1024
# 时间预算（三段独立，research 不再被 preloop 重复扣减）
#   research = 正式 loop 的完整研究预算（200s）
#   preloop  = 轻量启动器上限（35s）
#   finalize = 收尾轮 LLM 组织答案的时限（70s，受 research 剩余预算封顶）
IC_PRELOOP_TIMEOUT_SECONDS=35
IC_RESEARCH_TIMEOUT_SECONDS=200
IC_FINALIZE_TIMEOUT_SECONDS=70
IC_TRACE_ENABLED=true
IC_TRACE_DIR=/app/data/traces

# ── 行情数据 ──
IC_WESTOCK_ENABLED=True
IC_WESTOCK_BIN=westock-data-clawhub

# ── 邮箱验证码（必须填，否则验证码只打印日志）──
IC_SMTP_HOST=smtp.example.com
IC_SMTP_PORT=465
IC_SMTP_USER=noreply@example.com
IC_SMTP_PASS=填入 SMTP 密码
IC_SMTP_FROM=以渔 <noreply@example.com>

# ── 鉴权 ──
IC_AUTH_SECRET=改成一个随机长字符串（生产必须改）
IC_SESSION_TOKEN_TTL_DAYS=30
IC_AUTH_CODE_TTL_MINUTES=5
IC_AUTH_SEND_CODE_COOLDOWN_SECONDS=60
IC_AUTH_IP_DAILY_LIMIT=10

# ── CORS（同域部署留空即可；如前后端分域填前端域名）──
CORS_ORIGINS=["https://你的域名"]

# ── Caddy 公网域名（docker compose 变量，必须填真实域名）──
YIYU_DOMAIN=research.example.com

# ── 服务 ──
IC_API_PREFIX=/api/v1
IC_HOST=0.0.0.0
IC_PORT=8000
